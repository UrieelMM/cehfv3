rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function active() {
      return signedIn() && profile().active == true;
    }

    function isDirector() {
      return active()
        && profile().role == "director"
        && request.auth.token.role == "director"
        && request.auth.token.institutionId == profile().institutionId
        && request.auth.token.allPermissions == true;
    }

    function isStaff() {
      return isDirector() || (active() && profile().role == "teacher");
    }

    function sameInstitution(institutionId) {
      return active() && profile().institutionId == institutionId;
    }

    function sameInstitutionToken(institutionId) {
      return signedIn()
        && request.auth.token.institutionId == institutionId;
    }

    function canManageProfilePhoto(institutionId, userId) {
      return sameInstitutionToken(institutionId)
        && (
          request.auth.uid == userId || (
            request.auth.token.role == "director"
            && request.auth.token.allPermissions == true
          )
        );
    }

    function safeUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
          "(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|image/.*|audio/.*|text/plain)"
        );
    }

    function forumSafeUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("(application/pdf|image/.*)");
    }

    function workshopSafeUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
          "(application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|application/(zip|x-zip-compressed)|image/.*|audio/.*|video/.*|text/(plain|csv))"
        );
    }

    function materialSafeUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches(
          "(application/pdf|application/octet-stream|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|image/.*|audio/.*|video/.*|text/(plain|csv))"
        );
    }

    function reviewSafeUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
          "(application/pdf|application/octet-stream|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|image/.*|audio/.*|text/plain)"
        );
    }

    function taskResourceSafeUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches(
          "(application/pdf|application/octet-stream|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|image/.*|audio/.*|video/.*|text/(plain|csv))"
        );
    }

    function academicCalendarImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          "image/(jpeg|jpg|pjpeg|png|webp)"
        );
    }

    function learningMaterial(institutionId, materialId) {
      return firestore.get(
        /databases/(default)/documents/institutions/$(institutionId)/materials/$(materialId)
      ).data;
    }

    function canReadLearningMaterial(institutionId, materialId) {
      let material = learningMaterial(institutionId, materialId);
      return sameInstitution(institutionId)
        && material.institutionId == institutionId
        && (
          isDirector()
          || (
            profile().role == "teacher"
            && material.managerIds is list
            && request.auth.uid in material.managerIds
          )
          || (
            profile().role == "student"
            && material.audienceStudentIds is list
            && request.auth.uid in material.audienceStudentIds
          )
        );
    }

    function weeklyReview(reviewId) {
      return firestore.get(
        /databases/(default)/documents/weeklyReviews/$(reviewId)
      ).data;
    }

    function canReadWeeklyReview(institutionId, reviewId) {
      let review = weeklyReview(reviewId);
      return sameInstitution(institutionId)
        && review.institutionId == institutionId
        && (
          isDirector()
          || (
            profile().role == "teacher"
            && review.managerIds is list
            && request.auth.uid in review.managerIds
          )
          || (
            profile().role == "student"
            && review.audienceStudentIds is list
            && request.auth.uid in review.audienceStudentIds
            && review.status in ["published", "closed"]
          )
        );
    }

    function workshop(institutionId, workshopId) {
      return firestore.get(
        /databases/(default)/documents/institutions/$(institutionId)/workshops/$(workshopId)
      ).data;
    }

    function canReadWorkshop(institutionId, workshopId) {
      let data = workshop(institutionId, workshopId);
      return sameInstitution(institutionId)
        && data.institutionId == institutionId
        && (
          isDirector()
          || (
            data.memberIds is list
            && request.auth.uid in data.memberIds
          )
        );
    }

    function canManageWorkshop(institutionId, workshopId) {
      let data = workshop(institutionId, workshopId);
      return sameInstitution(institutionId)
        && data.institutionId == institutionId
        && (
          isDirector()
          || (
            profile().role == "teacher"
            && data.managerIds is list
            && request.auth.uid in data.managerIds
          )
        );
    }

    function workshopTask(institutionId, workshopId, taskId) {
      return firestore.get(
        /databases/(default)/documents/institutions/$(institutionId)/workshops/$(workshopId)/tasks/$(taskId)
      ).data;
    }

    function canReadWorkshopTask(institutionId, workshopId, taskId) {
      let task = workshopTask(institutionId, workshopId, taskId);
      return canReadWorkshop(institutionId, workshopId)
        && (
          isDirector()
          || (
            profile().role == "teacher"
            && task.createdBy == request.auth.uid
          )
          || (
            profile().role == "student"
            && task.audienceStudentIds is list
            && request.auth.uid in task.audienceStudentIds
            && task.status in ["published", "closed"]
          )
        );
    }

    function canManageWorkshopTask(institutionId, workshopId, taskId) {
      let task = workshopTask(institutionId, workshopId, taskId);
      return isDirector()
        || (
          canManageWorkshop(institutionId, workshopId)
          && profile().role == "teacher"
          && task.createdBy == request.auth.uid
        );
    }

    function canUploadWorkshopSubmission(institutionId, workshopId, taskId, studentId) {
      let task = workshopTask(institutionId, workshopId, taskId);
      return sameInstitution(institutionId)
        && profile().role == "student"
        && request.auth.uid == studentId
        && task.status == "published"
        && task.audienceStudentIds is list
        && studentId in task.audienceStudentIds;
    }

    function forumParticipationEnabled(institutionId) {
      let banPath = /databases/(default)/documents/forumBans/$(institutionId)/users/$(request.auth.uid);
      return !firestore.exists(banPath) || firestore.get(banPath).data.active != true;
    }

    function academicTask(institutionId, schoolYearId, termId, weekId, subjectId, taskId) {
      return firestore.get(
        /databases/(default)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId)/semanas/$(weekId)/materias/$(subjectId)/tareas/$(taskId)
      ).data;
    }

    function canReadAcademicTask(institutionId, schoolYearId, termId, weekId, subjectId, taskId) {
      let task = academicTask(
        institutionId, schoolYearId, termId, weekId, subjectId, taskId
      );
      return sameInstitution(institutionId) && (
        isStaff() || (
          profile().role == "student"
          && task.targetGroup == profile().grade + " " + profile().group
          && task.status in ["published", "closed"]
        )
      );
    }

    function hasActiveTaskExtension(institutionId, schoolYearId, termId, weekId, subjectId, taskId, studentId) {
      return firestore.exists(
        /databases/(default)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId)/semanas/$(weekId)/materias/$(subjectId)/tareas/$(taskId)/prorrogas/$(studentId)
      ) && firestore.get(
        /databases/(default)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId)/semanas/$(weekId)/materias/$(subjectId)/tareas/$(taskId)/prorrogas/$(studentId)
      ).data.dueAt >= request.time;
    }

    function canUploadTaskSubmission(institutionId, schoolYearId, termId, weekId, subjectId, taskId, studentId) {
      let task = academicTask(
        institutionId, schoolYearId, termId, weekId, subjectId, taskId
      );
      return sameInstitution(institutionId)
        && request.auth.uid == studentId
        && profile().role == "student"
        && task.targetGroup == profile().grade + " " + profile().group
        && (
          (task.status == "published" && request.time <= task.dueAt) || (
            task.status in ["published", "closed"]
            && hasActiveTaskExtension(
              institutionId, schoolYearId, termId, weekId, subjectId,
              taskId, studentId
            )
          )
        );
    }

    match /institutions/{institutionId}/ciclosEscolares/{schoolYearId}/bimestres/{termId}/semanas/{weekId}/materias/{subjectId}/tareas/{taskId}/recursos/{assetId} {
      allow read: if canReadAcademicTask(
        institutionId, schoolYearId, termId, weekId, subjectId, taskId
      );
      allow create: if isStaff()
        && sameInstitution(institutionId)
        && taskResourceSafeUpload();
      allow update: if false;
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/ciclosEscolares/{schoolYearId}/bimestres/{termId}/semanas/{weekId}/materias/{subjectId}/tareas/{taskId}/entregas/{studentId}/{versionId}/{assetId} {
      allow read: if canReadAcademicTask(
        institutionId, schoolYearId, termId, weekId, subjectId, taskId
      ) && (request.auth.uid == studentId || isStaff());
      allow create: if sameInstitution(institutionId)
        && canUploadTaskSubmission(
          institutionId, schoolYearId, termId, weekId, subjectId, taskId,
          studentId
        )
        && safeUpload();
      allow update: if false;
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/tasks/{taskId}/resources/{assetId} {
      allow read: if sameInstitution(institutionId);
      allow create, update: if isStaff()
        && sameInstitution(institutionId)
        && taskResourceSafeUpload();
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/materials/{materialId}/{assetId} {
      allow read: if canReadLearningMaterial(institutionId, materialId);
      allow create: if isStaff()
        && sameInstitution(institutionId)
        && materialSafeUpload();
      allow update: if false;
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/weeklyReviews/{reviewId}/{assetId} {
      allow read: if canReadWeeklyReview(institutionId, reviewId);
      // El archivo se carga antes de crear el documento; Cloud Functions
      // valida después la ruta exacta y el rol académico del creador.
      allow create: if isStaff()
        && sameInstitution(institutionId)
        && reviewSafeUpload();
      allow update: if false;
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/submissions/{studentId}/{submissionId}/{assetId} {
      allow read: if sameInstitution(institutionId)
        && (request.auth.uid == studentId || isStaff());
      allow create, update: if sameInstitution(institutionId)
        && (request.auth.uid == studentId || isDirector())
        && safeUpload();
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/wall/{postId}/{assetId} {
      allow read: if sameInstitution(institutionId);
      allow write: if isStaff()
        && sameInstitution(institutionId)
        && safeUpload();
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /institutions/{institutionId}/forum/{topicId}/{postId}/{assetId} {
      allow read: if sameInstitution(institutionId);
      allow create: if sameInstitution(institutionId)
        && forumParticipationEnabled(institutionId)
        && forumSafeUpload();
      allow update, delete: if isStaff()
        && sameInstitution(institutionId)
        && (request.resource == null || safeUpload());
    }

    match /institutions/{institutionId}/workshops/{workshopId}/resources/{resourceId}/{fileName} {
      allow read: if canReadWorkshop(institutionId, workshopId);
      allow create: if canManageWorkshop(institutionId, workshopId)
        && workshopSafeUpload();
      allow update: if false;
      allow delete: if canManageWorkshop(institutionId, workshopId);
    }

    match /institutions/{institutionId}/workshops/{workshopId}/tasks/{taskId}/resources/{assetId}/{fileName} {
      allow read: if canReadWorkshopTask(institutionId, workshopId, taskId);
      allow create: if canManageWorkshop(institutionId, workshopId)
        && workshopSafeUpload();
      allow update: if false;
      allow delete: if canManageWorkshop(institutionId, workshopId);
    }

    match /institutions/{institutionId}/workshops/{workshopId}/tasks/{taskId}/submissions/{studentId}/{versionId}/{assetId}/{fileName} {
      allow read: if canReadWorkshopTask(institutionId, workshopId, taskId)
        && (
          request.auth.uid == studentId
          || canManageWorkshopTask(institutionId, workshopId, taskId)
        );
      allow create: if canUploadWorkshopSubmission(
          institutionId, workshopId, taskId, studentId
        ) && workshopSafeUpload();
      allow update: if false;
      allow delete: if (
          request.auth.uid == studentId
          && canUploadWorkshopSubmission(
            institutionId, workshopId, taskId, studentId
          )
        ) || (isDirector() && sameInstitution(institutionId));
    }

    match /institutions/{institutionId}/profiles/{userId}/{assetId} {
      allow read: if sameInstitutionToken(institutionId);
      allow create, update: if canManageProfilePhoto(institutionId, userId)
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches("image/(jpeg|jpg|pjpeg|png|webp)");
      allow delete: if canManageProfilePhoto(institutionId, userId);
    }

    match /institutions/{institutionId}/academic-calendar/{assetId} {
      allow read: if sameInstitution(institutionId);
      allow create, update: if isDirector()
        && sameInstitution(institutionId)
        && academicCalendarImageUpload();
      allow delete: if isDirector() && sameInstitution(institutionId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

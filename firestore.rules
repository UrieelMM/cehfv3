rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function roleIs(role) {
      return isActive()
        && profile().role == role
        && (
          role != "director" || (
            request.auth.token.role == "director"
            && request.auth.token.institutionId == profile().institutionId
            && request.auth.token.allPermissions == true
          )
        );
    }

    function isStaff() {
      return roleIs("director") || roleIs("teacher");
    }

    function isDirector() {
      return roleIs("director");
    }

    function sameInstitution(data) {
      return isActive() && data.institutionId == profile().institutionId;
    }

    function validManagedAccountSubjects(data) {
      let primaryLower = [
        "Lenguaje", "Matemáticas", "Cívica", "Historia", "Física", "Inglés"
      ];
      let primaryUpper = [
        "Lenguaje", "Matemáticas", "Ciencias", "Historia", "Geografía",
        "Inglés", "Cívica", "Lectura y comprensión"
      ];
      let primarySixth = [
        "Lenguaje", "Matemáticas", "Ciencias", "Historia", "Geografía", "Inglés"
      ];
      let secondaryFirst = [
        "Lenguaje", "Matemáticas", "Cívica", "Geografía", "Biología", "Inglés"
      ];
      let allSubjects = [
        "Lenguaje", "Matemáticas", "Cívica", "Historia", "Física", "Inglés",
        "Ciencias", "Geografía", "Lectura y comprensión", "Biología"
      ];
      return data.subjects is list
        && data.subjects.size() > 0
        && data.subjects.toSet().size() == data.subjects.size()
        && data.subjects.hasOnly(allSubjects)
        && (
          data.role == "teacher"
          || (
            data.role == "student"
            && (
              (
                data.schoolLevel == "primary"
                && data.grade in ["1.º", "2.º", "3.º"]
                && data.subjects.hasOnly(primaryLower)
              )
              || (
                data.schoolLevel == "primary"
                && data.grade in ["4.º", "5.º"]
                && data.subjects.hasOnly(primaryUpper)
              )
              || (
                data.schoolLevel == "primary"
                && data.grade == "6.º"
                && data.subjects.hasOnly(primarySixth)
              )
              || (
                data.schoolLevel == "secondary"
                && data.grade == "1.º"
                && data.subjects.hasOnly(secondaryFirst)
              )
              || (
                data.schoolLevel == "secondary"
                && data.grade in ["2.º", "3.º"]
                && data.subjects.hasOnly(primaryLower)
              )
            )
          )
        );
    }

    function canQueryAcademicTask(data) {
      return sameInstitution(data) && (
        isDirector() ||
        (
          roleIs("teacher")
          && data.createdBy == request.auth.uid
        ) ||
        (
          roleIs("student")
          && data.targetGroup == profile().grade + " " + profile().group
          && data.status in ["published", "closed"]
        )
      );
    }

    function calendarWeekPath(institutionId, schoolYearId, weekId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/semanas/$(weekId);
    }

    function calendarTermPath(institutionId, schoolYearId, termId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId);
    }

    function calendarNonWorkingDayPath(institutionId, schoolYearId, gradeDate) {
      return /databases/$(database)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/diasNoLaborales/$(gradeDate);
    }

    function validCalendarScope(data) {
      let weekPath = calendarWeekPath(
        data.institutionId, data.schoolYearId, data.weekId
      );
      let termPath = calendarTermPath(
        data.institutionId, data.schoolYearId, data.termId
      );
      return data.institutionId is string
        && data.schoolYearId is string
        && data.termId is string
        && data.weekId is string
        && exists(weekPath)
        && exists(termPath)
        && get(weekPath).data.active == true
        && get(termPath).data.active == true
        && get(termPath).data.weekIds is list
        && get(termPath).data.weekIds.hasAny([data.weekId])
        && data.weekLabel == get(weekPath).data.label
        && data.termLabel == get(termPath).data.label;
    }

    function sameCalendarScope(before, after) {
      return after.schoolYearId == before.schoolYearId
        && after.termId == before.termId
        && after.weekId == before.weekId
        && after.termLabel == before.termLabel
        && after.weekLabel == before.weekLabel;
    }

    function validCurrentTaskScope(
      data, institutionId, schoolYearId, termId, weekId
    ) {
      let weekPath = calendarWeekPath(institutionId, schoolYearId, weekId);
      let termPath = calendarTermPath(institutionId, schoolYearId, termId);
      return exists(weekPath)
        && exists(termPath)
        && get(weekPath).data.active == true
        && get(termPath).data.active == true
        && get(termPath).data.weekIds is list
        && get(termPath).data.weekIds.hasAny([weekId])
        && request.time >= get(weekPath).data.startAt
        && request.time < get(weekPath).data.endAt
        && data.institutionId == institutionId
        && data.schoolYearId == schoolYearId
        && data.termId == termId
        && data.weekId == weekId
        && data.termLabel == get(termPath).data.label
        && data.weekLabel == get(weekPath).data.label;
    }

    match /system/bootstrap {
      allow read: if isDirector();
      allow write: if false;
    }

    // Firestore evalúa collectionGroup("tareas") contra todas las rutas que
    // terminan en /tareas/{taskId}. El comodín recursivo es obligatorio para
    // autorizar esa consulta; los filtros de datos mantienen el aislamiento.
    match /{taskPath=**}/tareas/{taskId} {
      allow list: if canQueryAcademicTask(resource.data);
    }

    match /users/{userId} {
      allow get: if isActive()
        && resource.data.institutionId == profile().institutionId
        && (
        request.auth.uid == userId ||
        isDirector() ||
        (roleIs("teacher") && resource.data.role == "student")
      );
      allow list: if resource.data.institutionId == profile().institutionId
        && (
          isDirector() ||
          roleIs("teacher") ||
          (
            roleIs("student") &&
            resource.data.role == "director" &&
            resource.data.active == true
          )
        );
      allow create: if isDirector()
        && request.resource.data.role in ["student", "teacher"]
        && request.resource.data.active == true
        && request.resource.data.institutionId == profile().institutionId
        && validManagedAccountSubjects(request.resource.data);
      allow update: if (
        isDirector()
        && resource.data.institutionId == profile().institutionId
        && request.resource.data.institutionId == profile().institutionId
        && (
          (
            request.auth.uid == userId
            && request.resource.data.role == "director"
            && request.resource.data.active == true
          ) || (
            request.auth.uid != userId
            && request.resource.data.role in ["student", "teacher"]
            && validManagedAccountSubjects(request.resource.data)
          )
        )
      ) || (
        isActive()
        && request.auth.uid == userId
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "initials", "updatedAt"])
      );
      allow delete: if false;

      match /preferences/{preferenceId} {
        allow read, write: if isActive() && request.auth.uid == userId;
      }

      match /privateState/{stateId} {
        allow read, write: if isActive() && request.auth.uid == userId;
      }
    }

    match /institutions/{institutionId} {
      allow read: if isActive() && profile().institutionId == institutionId;
      allow create, update: if isDirector()
        && profile().institutionId == institutionId
        && request.resource.data.institutionId == institutionId;
      allow delete: if false;

      match /portal/{documentId} {
        allow read: if isActive() && profile().institutionId == institutionId;
        allow create: if isDirector()
          && profile().institutionId == institutionId;
        allow update: if profile().institutionId == institutionId
          && (
            isDirector()
            || (
              roleIs("teacher")
              && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(["weeklyVerse"])
            )
          );
        allow delete: if false;
      }

      match /staffWorkspace/{itemId} {
        function activeWorkspaceStaff(userId) {
          let member = get(
            /databases/$(database)/documents/users/$(userId)
          ).data;
          return member.active == true
            && member.institutionId == institutionId
            && member.role in ["director", "teacher"];
        }

        function validWorkspaceItem(data) {
          return data.keys().hasAll([
              "institutionId", "ownerId", "ownerName", "type", "title",
              "content", "visibility", "pinned", "eventAt", "resourceUrl",
              "sharedWithIds", "mentionedUserIds", "subject", "group", "location",
              "attachments", "createdAt", "updatedAt"
            ])
            && data.keys().hasOnly([
              "institutionId", "ownerId", "ownerName", "type", "title",
              "content", "visibility", "pinned", "eventAt", "resourceUrl",
              "sharedWithIds", "mentionedUserIds", "assigneeIds", "subject", "group", "location",
              "folder", "tags", "archived", "isTemplate", "attachments", "createdAt", "updatedAt"
            ])
            && data.institutionId == institutionId
            && data.ownerId is string
            && data.ownerName is string
            && data.type in ["planning", "resource", "schedule", "note"]
            && data.title is string
            && data.title.size() > 0
            && data.title.size() <= 120
            && data.content is string
            && data.content.size() <= 200000
            && data.visibility in ["private", "selected", "staff"]
            && data.sharedWithIds is list
            && data.sharedWithIds.size() <= 100
            && data.mentionedUserIds is list
            && data.mentionedUserIds.size() <= 100
            && data.get("assigneeIds", []) is list
            && data.get("assigneeIds", []).size() <= 100
            && data.pinned is bool
            && data.get("archived", false) is bool
            && data.get("isTemplate", false) is bool
            && data.get("folder", "") is string
            && data.get("folder", "").size() <= 80
            && data.get("tags", []) is list
            && data.get("tags", []).size() <= 12
            && data.eventAt is string
            && data.resourceUrl is string
            && data.subject is string
            && data.group is string
            && data.location is string
            && data.attachments is list
            && data.attachments.size() <= 50
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        function canReadWorkspaceItem(data) {
          return isStaff()
            && profile().institutionId == institutionId
            && data.institutionId == institutionId
            && (
              data.ownerId == request.auth.uid
              || data.visibility == "staff"
              || (
                data.visibility == "selected"
                && data.sharedWithIds is list
                && request.auth.uid in data.sharedWithIds
              )
            );
        }

        allow read: if canReadWorkspaceItem(resource.data);
        allow create: if isStaff()
          && profile().institutionId == institutionId
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerName == profile().name
          && validWorkspaceItem(request.resource.data);
        allow update: if isStaff()
          && profile().institutionId == institutionId
          && resource.data.ownerId == request.auth.uid
          && (
            (
              request.resource.data.ownerId == resource.data.ownerId
              && request.resource.data.ownerName == resource.data.ownerName
            ) || (
              activeWorkspaceStaff(request.resource.data.ownerId)
              && request.resource.data.ownerName == get(
                /databases/$(database)/documents/users/$(request.resource.data.ownerId)
              ).data.name
            )
          )
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "type", "title", "content", "visibility", "pinned", "eventAt",
            "resourceUrl", "sharedWithIds", "mentionedUserIds", "assigneeIds", "subject", "group",
            "location", "folder", "tags", "archived", "isTemplate", "attachments", "ownerId",
            "ownerName", "updatedAt"
          ])
          && validWorkspaceItem(request.resource.data);
        allow delete: if isStaff()
          && profile().institutionId == institutionId
          && resource.data.ownerId == request.auth.uid;
      }

      function workspaceItemData(itemId) {
        return get(
          /databases/$(database)/documents/institutions/$(institutionId)/staffWorkspace/$(itemId)
        ).data;
      }

      function canReadWorkspaceRecord(itemId) {
        let item = workspaceItemData(itemId);
        return isStaff()
          && profile().institutionId == institutionId
          && item.institutionId == institutionId
          && (
            item.ownerId == request.auth.uid
            || item.visibility == "staff"
            || (
              item.visibility == "selected"
              && request.auth.uid in item.sharedWithIds
            )
          );
      }

      match /staffWorkspaceReads/{receiptId} {
        function validWorkspaceRead(data) {
          return data.keys().hasAll([
              "institutionId", "itemId", "readerId", "readerName", "readAt"
            ])
            && data.keys().hasOnly([
              "institutionId", "itemId", "readerId", "readerName", "readAt"
            ])
            && data.institutionId == institutionId
            && data.itemId is string
            && data.readerId is string
            && data.readerName is string
            && data.readAt is timestamp;
        }

        allow read: if isStaff()
          && profile().institutionId == institutionId
          && (
            resource.data.readerId == request.auth.uid
            || canReadWorkspaceRecord(resource.data.itemId)
          );
        allow create, update: if isStaff()
          && profile().institutionId == institutionId
          && request.resource.data.readerId == request.auth.uid
          && request.resource.data.readerName == profile().name
          && canReadWorkspaceRecord(request.resource.data.itemId)
          && validWorkspaceRead(request.resource.data);
        allow delete: if false;
      }

      match /staffWorkspaceComments/{commentId} {
        function validWorkspaceComment(data) {
          return data.keys().hasAll([
              "institutionId", "itemId", "authorId", "authorName",
              "authorInitials", "content", "createdAt"
            ])
            && data.keys().hasOnly([
              "institutionId", "itemId", "authorId", "authorName",
              "authorInitials", "content", "createdAt"
            ])
            && data.institutionId == institutionId
            && data.itemId is string
            && data.authorId is string
            && data.authorName is string
            && data.authorInitials is string
            && data.content is string
            && data.content.size() > 0
            && data.content.size() <= 2000
            && data.createdAt is timestamp;
        }

        allow read: if canReadWorkspaceRecord(resource.data.itemId);
        allow create: if isStaff()
          && profile().institutionId == institutionId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == profile().name
          && canReadWorkspaceRecord(request.resource.data.itemId)
          && validWorkspaceComment(request.resource.data);
        allow update: if false;
        allow delete: if isStaff()
          && profile().institutionId == institutionId
          && (
            resource.data.authorId == request.auth.uid
            || workspaceItemData(resource.data.itemId).ownerId == request.auth.uid
          );
      }

      match /staffWorkspaceActivity/{activityId} {
        function validWorkspaceActivity(data) {
          return data.keys().hasAll([
              "institutionId", "itemId", "actorId", "actorName",
              "action", "detail", "createdAt"
            ])
            && data.keys().hasOnly([
              "institutionId", "itemId", "actorId", "actorName",
              "action", "detail", "createdAt"
            ])
            && data.institutionId == institutionId
            && data.itemId is string
            && data.actorId is string
            && data.actorName is string
            && data.action in [
              "created", "updated", "commented", "archived", "restored",
              "transferred", "template_created"
            ]
            && data.detail is string
            && data.detail.size() <= 240
            && data.createdAt is timestamp;
        }

        allow read: if canReadWorkspaceRecord(resource.data.itemId);
        allow create: if isStaff()
          && profile().institutionId == institutionId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName == profile().name
          && canReadWorkspaceRecord(request.resource.data.itemId)
          && validWorkspaceActivity(request.resource.data);
        allow update, delete: if false;
      }

      match /workshops/{workshopId} {
        function validWorkshopAccess(data) {
          return data.studentIds is list
            && data.teacherIds is list
            && data.managerIds is list
            && data.teacherStudentIds is map
            && data.memberIds is list
            && data.managerIds.hasOnly(data.teacherIds)
            && data.memberIds.toSet()
              == data.studentIds.toSet().union(data.teacherIds.toSet());
        }

        function canReadWorkshop(data) {
          return isActive()
            && profile().institutionId == institutionId
            && data.institutionId == institutionId
            && (
              isDirector()
              || (
                data.memberIds is list
                && request.auth.uid in data.memberIds
              )
            );
        }

        function workshopData() {
          return get(
            /databases/$(database)/documents/institutions/$(institutionId)/workshops/$(workshopId)
          ).data;
        }

        function canManageWorkshop() {
          let workshop = workshopData();
          return isActive()
            && profile().institutionId == institutionId
            && workshop.institutionId == institutionId
            && (
              isDirector()
              || (
                roleIs("teacher")
                && workshop.managerIds is list
                && request.auth.uid in workshop.managerIds
              )
            );
        }

        allow read: if canReadWorkshop(resource.data);
        allow create: if isDirector()
          && profile().institutionId == institutionId
          && workshopId in ["tics", "reading", "club-lectura"]
          && request.resource.data.institutionId == institutionId
          && request.resource.data.kind in ["tics", "reading"]
          && validWorkshopAccess(request.resource.data);
        allow update: if isDirector()
          && profile().institutionId == institutionId
          && resource.data.institutionId == institutionId
          && request.resource.data.institutionId == institutionId
          && request.resource.data.kind == resource.data.kind
          && validWorkshopAccess(request.resource.data);
        allow delete: if false;

        match /resources/{resourceId} {
          allow read: if canReadWorkshop(workshopData());
          allow create: if canManageWorkshop()
            && request.resource.data.institutionId == institutionId
            && request.resource.data.workshopId == workshopId
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.title is string
            && request.resource.data.storagePath is string
            && request.resource.data.size is number
            && request.resource.data.size > 0
            && request.resource.data.size < 20 * 1024 * 1024;
          allow update: if false;
          allow delete: if canManageWorkshop();
        }

        match /tasks/{taskId} {
          function taskData() {
            return get(
              /databases/$(database)/documents/institutions/$(institutionId)/workshops/$(workshopId)/tasks/$(taskId)
            ).data;
          }

          function canReadWorkshopTask(data) {
            return canReadWorkshop(workshopData())
              && (
                isDirector()
                || (
                  roleIs("teacher")
                  && data.createdBy == request.auth.uid
                )
                || (
                  roleIs("student")
                  && data.audienceStudentIds is list
                  && request.auth.uid in data.audienceStudentIds
                  && data.status in ["published", "closed"]
                )
              );
          }

          function canManageWorkshopTask(data) {
            return isDirector()
              || (
                roleIs("teacher")
                && data.createdBy == request.auth.uid
                && canManageWorkshop()
              );
          }

          function validWorkshopTaskAudience(data) {
            let workshop = workshopData();
            return data.audienceStudentIds is list
              && data.audienceStudentIds.size() > 0
              && (
                (
                  isDirector()
                  && data.audienceStudentIds.hasOnly(workshop.studentIds)
                )
                || (
                  roleIs("teacher")
                  && workshop.teacherStudentIds is map
                  && workshop.teacherStudentIds[request.auth.uid] is list
                  && data.audienceStudentIds.hasOnly(
                    workshop.teacherStudentIds[request.auth.uid]
                  )
                )
              );
          }

          allow read: if canReadWorkshopTask(resource.data);
          allow create: if canManageWorkshop()
            && request.resource.data.institutionId == institutionId
            && request.resource.data.workshopId == workshopId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.title is string
            && request.resource.data.description is string
            && request.resource.data.dueAt is timestamp
            && request.resource.data.status in ["draft", "published"]
            && request.resource.data.attachments is list
            && validWorkshopTaskAudience(request.resource.data);
          allow update: if canManageWorkshopTask(resource.data)
            && request.resource.data.institutionId == resource.data.institutionId
            && request.resource.data.workshopId == resource.data.workshopId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.audienceStudentIds == resource.data.audienceStudentIds
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt"])
            && request.resource.data.status in ["draft", "published", "closed"];
          allow delete: if false;

          match /submissions/{studentId} {
            function parentTask() {
              return taskData();
            }

            function studentCanSubmit() {
              let task = parentTask();
              return roleIs("student")
                && request.auth.uid == studentId
                && task.status == "published"
                && task.audienceStudentIds is list
                && studentId in task.audienceStudentIds;
            }

            function canReadWorkshopSubmission(data) {
              let task = parentTask();
              return canReadWorkshop(workshopData())
                && (
                  isDirector()
                  || (
                    roleIs("teacher")
                    && task.createdBy == request.auth.uid
                  )
                  || (
                    roleIs("student")
                    && request.auth.uid == studentId
                    && data.studentId == studentId
                  )
                );
            }

            allow read: if canReadWorkshopSubmission(resource.data);
            allow create: if studentCanSubmit()
              && request.resource.data.studentId == studentId
              && request.resource.data.taskId == taskId
              && request.resource.data.workshopId == workshopId
              && request.resource.data.institutionId == institutionId
              && request.resource.data.status == "submitted"
              && request.resource.data.version == 1;
            allow update: if (
              studentCanSubmit()
              && resource.data.studentId == studentId
              && request.resource.data.studentId == studentId
              && request.resource.data.institutionId == resource.data.institutionId
              && request.resource.data.workshopId == resource.data.workshopId
              && request.resource.data.taskId == resource.data.taskId
              && request.resource.data.version == resource.data.version + 1
              && request.resource.data.status == "submitted"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "content", "attachments", "version", "status",
                  "teacherFeedback", "submittedAt", "feedbackAt",
                  "reviewedAt", "updatedAt"
                ])
            ) || (
              canManageWorkshopTask(parentTask())
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.version == resource.data.version
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "teacherFeedback", "status", "feedbackAt",
                  "reviewedAt", "updatedAt"
                ])
              && request.resource.data.status in ["feedback", "reviewed"]
            );
            allow delete: if false;

            match /history/{versionId} {
              allow read: if canReadWorkshop(workshopData())
                && (
                  isDirector()
                  || (
                    roleIs("teacher")
                    && parentTask().createdBy == request.auth.uid
                  )
                  || (roleIs("student") && request.auth.uid == studentId)
                );
              allow create: if studentCanSubmit()
                && request.resource.data.studentId == studentId
                && request.resource.data.taskId == taskId
                && request.resource.data.status == "submitted";
              allow update, delete: if false;
            }
          }
        }
      }

      function validVisualCalendar(data) {
        return data.keys().hasAll([
            "institutionId", "imagePath", "fileName", "contentType", "size",
            "published", "updatedBy", "updatedByName", "updatedAt"
          ])
          && data.keys().hasOnly([
            "institutionId", "imagePath", "fileName", "contentType", "size",
            "published", "updatedBy", "updatedByName", "updatedAt"
          ])
          && data.institutionId == institutionId
          && data.imagePath is string
          && data.fileName is string
          && data.fileName.size() <= 160
          && data.contentType is string
          && data.size is int
          && data.size >= 0
          && data.size <= 10 * 1024 * 1024
          && data.published is bool
          && data.updatedBy == request.auth.uid
          && data.updatedByName is string
          && data.updatedByName.size() > 0
          && data.updatedAt is timestamp
          && (
            (
              data.published == true
              && data.imagePath.matches(
                "institutions/" + institutionId + "/academic-calendar/[^/]+"
              )
              && data.contentType.matches("image/(jpeg|jpg|pjpeg|png|webp)")
              && data.size > 0
            ) || (
              data.published == false
              && data.imagePath == ""
              && data.fileName == ""
              && data.contentType == ""
              && data.size == 0
            )
          );
      }

      match /configuracion/calendarioVisual {
        allow read: if isActive() && profile().institutionId == institutionId;
        allow create, update: if isDirector()
          && profile().institutionId == institutionId
          && validVisualCalendar(request.resource.data);
        allow delete: if false;
      }

      match /configuracion/{documentId} {
        allow read: if isActive() && profile().institutionId == institutionId;
        allow create, update: if !(documentId in ["academica", "whatsapp", "calendarioVisual"])
          && isDirector()
          && profile().institutionId == institutionId
          && request.resource.data.institutionId == institutionId;
        allow delete: if false;
      }

      function validGradingWeights(weights) {
        return weights is map
          && weights.keys().hasOnly([
            "classWork", "homework", "participation", "attendance", "exam"
          ])
          && weights.classWork is number
          && weights.homework is number
          && weights.participation is number
          && weights.attendance is number
          && weights.exam is number
          && weights.classWork >= 0 && weights.classWork <= 100
          && weights.homework >= 0 && weights.homework <= 100
          && weights.participation >= 0 && weights.participation <= 100
          && weights.attendance >= 0 && weights.attendance <= 100
          && weights.exam >= 0 && weights.exam <= 100
          && weights.classWork
            + weights.homework
            + weights.participation
            + weights.attendance
            + weights.exam == 100;
      }

      function validGradeScores(scores) {
        return scores is map
          && scores.keys().hasOnly([
            "classWork", "homework", "participation", "attendance", "exam"
          ])
          && scores.classWork is number
          && scores.homework is number
          && scores.participation is number
          && scores.attendance is number
          && scores.exam is number
          && scores.classWork >= 0 && scores.classWork <= 10
          && scores.homework >= 0 && scores.homework <= 10
          && scores.participation >= 0 && scores.participation <= 10
          && scores.attendance >= 0 && scores.attendance <= 10
          && scores.exam >= 0 && scores.exam <= 10;
      }

      function gradingStudent(studentId) {
        return get(
          /databases/$(database)/documents/users/$(studentId)
        ).data;
      }

      function teacherCanGrade(data) {
        let student = gradingStudent(data.studentId);
        return roleIs("teacher")
          && profile().institutionId == institutionId
          && data.institutionId == institutionId
          && data.teacherId == request.auth.uid
          && data.teacherName == profile().name
          && data.studentId is string
          && exists(
            /databases/$(database)/documents/users/$(data.studentId)
          )
          && student.active == true
          && student.role == "student"
          && student.institutionId == institutionId
          && data.studentName == student.name
          && student.teacherIds is list
          && student.teacherIds.hasAny([request.auth.uid])
          && student.subjects is list
          && student.subjects.hasAny([data.subject])
          && profile().subjects is list
          && profile().subjects.hasAny([data.subject]);
      }

      function validWeeklyGrade(data) {
        let calculatedScore = (
          data.scores.classWork * data.weights.classWork
          + data.scores.homework * data.weights.homework
          + data.scores.participation * data.weights.participation
          + data.scores.attendance * data.weights.attendance
          + data.scores.exam * data.weights.exam
        ) / 100;
        return data.keys().hasOnly([
            "institutionId", "schoolYearId", "schoolYearLabel",
            "termId", "termLabel", "weekId", "weekLabel",
            "subjectId", "subject", "teacherId", "teacherName",
            "studentId", "studentName", "studentGrade", "studentGroup",
            "scores", "weights", "weightedScore", "createdAt", "updatedAt"
          ])
          && data.subjectId is string
          && data.subject is string
          && data.studentName is string
          && data.weekLabel is string
          && data.termLabel is string
          && validGradingWeights(data.weights)
          && validGradeScores(data.scores)
          && data.weightedScore is number
          && data.weightedScore >= 0
          && data.weightedScore <= 10
          && data.weightedScore >= calculatedScore - 0.051
          && data.weightedScore <= calculatedScore + 0.051
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && validCalendarScope(data);
      }

      function sameWeeklyGradeScope(before, after) {
        return after.institutionId == before.institutionId
          && after.schoolYearId == before.schoolYearId
          && sameCalendarScope(before, after)
          && after.subjectId == before.subjectId
          && after.subject == before.subject
          && after.teacherId == before.teacherId
          && after.studentId == before.studentId;
      }

      function validDailyGrade(data) {
        let weekPath = calendarWeekPath(
          data.institutionId, data.schoolYearId, data.weekId
        );
        let nonWorkingDayPath = calendarNonWorkingDayPath(
          data.institutionId, data.schoolYearId, data.gradeDate
        );
        let calculatedScore = (
          data.scores.classWork * data.weights.classWork
          + data.scores.homework * data.weights.homework
          + data.scores.participation * data.weights.participation
          + data.scores.attendance * data.weights.attendance
          + data.scores.exam * data.weights.exam
        ) / 100;
        return data.keys().hasOnly([
            "institutionId", "schoolYearId", "schoolYearLabel",
            "termId", "termLabel", "weekId", "weekLabel", "gradeDate",
            "subjectId", "subject", "teacherId", "teacherName",
            "studentId", "studentName", "studentGrade", "studentGroup",
            "scores", "weights", "weightedScore", "createdAt", "updatedAt"
          ])
          && data.gradeDate is string
          && data.gradeDate >= get(weekPath).data.startDate
          && data.gradeDate <= get(weekPath).data.endDate
          && (
            !exists(nonWorkingDayPath)
            || get(nonWorkingDayPath).data.active != true
          )
          && data.subjectId is string
          && data.subject is string
          && data.studentName is string
          && validGradingWeights(data.weights)
          && validGradeScores(data.scores)
          && data.weightedScore is number
          && data.weightedScore >= 0
          && data.weightedScore <= 10
          && data.weightedScore >= calculatedScore - 0.051
          && data.weightedScore <= calculatedScore + 0.051
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && validCalendarScope(data);
      }

      function sameDailyGradeScope(before, after) {
        return sameWeeklyGradeScope(before, after)
          && after.gradeDate == before.gradeDate;
      }

      function validStudentWeeklyReport(data) {
        return data.keys().hasOnly([
            "institutionId", "schoolYearId", "schoolYearLabel",
            "termId", "termLabel", "weekId", "weekLabel",
            "subjectId", "subject", "teacherId", "teacherName",
            "studentId", "studentName", "studentGrade", "studentGroup",
            "achievement", "supportArea", "nextStep", "weeklyScore",
            "gradedDays", "workingDays", "status", "createdAt", "updatedAt", "publishedAt"
          ])
          && data.achievement is string
          && data.achievement.size() > 0
          && data.achievement.size() <= 600
          && data.supportArea is string
          && data.supportArea.size() > 0
          && data.supportArea.size() <= 600
          && data.nextStep is string
          && data.nextStep.size() > 0
          && data.nextStep.size() <= 600
          && data.weeklyScore is number
          && data.weeklyScore >= 0
          && data.weeklyScore <= 10
          && data.gradedDays is int
          && data.gradedDays >= 0
          && data.workingDays is int
          && data.workingDays >= 0
          && data.gradedDays <= data.workingDays
          && data.status in ["draft", "published"]
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (
            (data.status == "published" && data.publishedAt is timestamp)
            || (data.status == "draft" && !("publishedAt" in data))
          )
          && validCalendarScope(data);
      }

      function sameStudentWeeklyReportScope(before, after) {
        return sameWeeklyGradeScope(before, after);
      }

      match /gradingConfigs/{teacherId} {
        allow read: if isActive()
          && profile().institutionId == institutionId
          && (isDirector() || request.auth.uid == teacherId);
        allow create, update: if roleIs("teacher")
          && profile().institutionId == institutionId
          && request.auth.uid == teacherId
          && request.resource.data.keys().hasOnly([
            "institutionId", "teacherId", "teacherName", "subjects",
            "weights", "updatedAt"
          ])
          && request.resource.data.institutionId == institutionId
          && request.resource.data.teacherId == teacherId
          && request.resource.data.teacherName is string
          && request.resource.data.subjects is list
          && profile().subjects is list
          && request.resource.data.subjects.toSet() == profile().subjects.toSet()
          && request.resource.data.updatedAt is timestamp
          && validGradingWeights(request.resource.data.weights);
        allow delete: if false;
      }

      match /weeklyGrades/{gradeId} {
        allow read: if isActive()
          && profile().institutionId == institutionId
          && resource.data.institutionId == institutionId
          && (
            isDirector()
            || (roleIs("teacher") && resource.data.teacherId == request.auth.uid)
            || (roleIs("student") && resource.data.studentId == request.auth.uid)
          );
        allow create: if teacherCanGrade(request.resource.data)
          && validWeeklyGrade(request.resource.data);
        allow update: if teacherCanGrade(resource.data)
          && teacherCanGrade(request.resource.data)
          && validWeeklyGrade(request.resource.data)
          && sameWeeklyGradeScope(resource.data, request.resource.data);
        allow delete: if false;
      }

      match /dailyGrades/{gradeId} {
        allow read: if isActive()
          && profile().institutionId == institutionId
          && resource.data.institutionId == institutionId
          && (
            isDirector()
            || (roleIs("teacher") && resource.data.teacherId == request.auth.uid)
            || (roleIs("student") && resource.data.studentId == request.auth.uid)
          );
        allow create: if teacherCanGrade(request.resource.data)
          && validDailyGrade(request.resource.data);
        allow update: if teacherCanGrade(resource.data)
          && teacherCanGrade(request.resource.data)
          && validDailyGrade(request.resource.data)
          && sameDailyGradeScope(resource.data, request.resource.data);
        allow delete: if false;
      }

      match /studentWeeklyReports/{reportId} {
        allow read: if isActive()
          && profile().institutionId == institutionId
          && resource.data.institutionId == institutionId
          && (
            isDirector()
            || (roleIs("teacher") && resource.data.teacherId == request.auth.uid)
            || (
              roleIs("student")
              && resource.data.studentId == request.auth.uid
              && resource.data.status == "published"
            )
          );
        allow create: if teacherCanGrade(request.resource.data)
          && validStudentWeeklyReport(request.resource.data);
        allow update: if teacherCanGrade(resource.data)
          && teacherCanGrade(request.resource.data)
          && validStudentWeeklyReport(request.resource.data)
          && sameStudentWeeklyReportScope(resource.data, request.resource.data);
        allow delete: if false;
      }

      match /ciclosEscolares/{schoolYearId} {
        allow read: if isActive() && profile().institutionId == institutionId;
        allow write: if false;

        match /semanas/{weekId} {
          allow read: if isActive() && profile().institutionId == institutionId;
          allow write: if false;
        }

        match /bimestres/{termId} {
          allow read: if isActive() && profile().institutionId == institutionId;
          allow write: if false;
        }

        match /diasNoLaborales/{dayId} {
          allow read: if isActive() && profile().institutionId == institutionId;
          allow write: if false;
        }

        match /calendarioHistorial/{eventId} {
          allow read: if isDirector() && profile().institutionId == institutionId;
          allow write: if false;
        }
      }

      match /ciclosEscolares/{schoolYearId}/bimestres/{termId}/semanas/{weekId}/materias/{subjectId}/tareas/{taskId} {
        function taskBelongsToInstitution(data) {
          return isActive()
            && profile().institutionId == institutionId
            && data.institutionId == institutionId;
        }

        // Las consultas collectionGroup no pueden demostrar el valor de un
        // segmento comodín de la ruta. Para lecturas se usa el ámbito
        // institucional inmutable del documento; create/update siguen
        // exigiendo que ese valor coincida también con la ruta física.
        function canReadTaskInstitution(data) {
          return isActive()
            && data.institutionId == profile().institutionId;
        }

        function isTaskStaff(data) {
          return isDirector() || (
            roleIs("teacher") && data.createdBy == request.auth.uid
          );
        }

        function isAssignedStudent(data) {
          return roleIs("student")
            && data.targetGroup == profile().grade + " " + profile().group;
        }

        function parentTaskPath() {
          return /databases/$(database)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId)/semanas/$(weekId)/materias/$(subjectId)/tareas/$(taskId);
        }

        function parentTask() {
          return get(parentTaskPath()).data;
        }

        function parentTaskAfterWrite() {
          return getAfter(parentTaskPath()).data;
        }

        function extensionPath(studentId) {
          return /databases/$(database)/documents/institutions/$(institutionId)/ciclosEscolares/$(schoolYearId)/bimestres/$(termId)/semanas/$(weekId)/materias/$(subjectId)/tareas/$(taskId)/prorrogas/$(studentId);
        }

        function hasActiveExtension(studentId) {
          return exists(extensionPath(studentId))
            && get(extensionPath(studentId)).data.dueAt >= request.time;
        }

        function canStudentSubmit(studentId) {
          let task = parentTask();
          return request.auth.uid == studentId
            && taskBelongsToInstitution(task)
            && isAssignedStudent(task)
            && task.status == "published"
            && (
              request.time <= task.dueAt
              || hasActiveExtension(studentId)
            );
        }

        allow read: if canReadTaskInstitution(resource.data) && (
          isTaskStaff(resource.data) || (
            isAssignedStudent(resource.data)
            && resource.data.status in ["published", "closed"]
          )
        );
        allow create: if taskBelongsToInstitution(request.resource.data)
          && isStaff()
          && request.resource.data.createdBy == request.auth.uid
          && validCurrentTaskScope(
            request.resource.data,
            institutionId,
            schoolYearId,
            termId,
            weekId
          )
          && request.resource.data.subjectId == subjectId
          && request.resource.data.status in ["draft", "scheduled", "published"];
        allow update: if taskBelongsToInstitution(resource.data)
          && taskBelongsToInstitution(request.resource.data)
          && isTaskStaff(resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.termId == resource.data.termId
          && request.resource.data.weekId == resource.data.weekId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.status in [
            "draft", "scheduled", "published", "closed", "archived"
          ];
        allow delete: if false;

        match /historial/{eventId} {
          allow read: if taskBelongsToInstitution(parentTask())
            && isTaskStaff(parentTask());
          // La creación y los cambios de estado de una tarea escriben su
          // historial en el mismo lote. getAfter valida el documento padre
          // tal como quedará al terminar ese lote, incluso en la creación.
          allow create: if taskBelongsToInstitution(parentTaskAfterWrite())
            && isTaskStaff(parentTaskAfterWrite())
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorRole in ["teacher", "director"];
          allow update, delete: if false;
        }

        match /prorrogas/{studentId} {
          allow read: if taskBelongsToInstitution(parentTask()) && (
            isTaskStaff(parentTask()) || request.auth.uid == studentId
          );
          allow create, update: if taskBelongsToInstitution(parentTask())
            && isTaskStaff(parentTask())
            && request.resource.data.institutionId == institutionId
            && request.resource.data.studentId == studentId
            && request.resource.data.dueAt > request.time;
          allow delete: if false;
        }

        match /resourceViews/{resourceId}/students/{studentId} {
          function validResourceView(data) {
            return data.keys().hasAll([
                "institutionId", "taskId", "resourceId", "resourceKind",
                "resourceLabel", "studentId", "studentName",
                "firstOpenedAt", "lastOpenedAt", "viewCount"
              ])
              && data.keys().hasOnly([
                "institutionId", "taskId", "resourceId", "resourceKind",
                "resourceLabel", "studentId", "studentName",
                "firstOpenedAt", "lastOpenedAt", "viewCount"
              ])
              && data.institutionId == institutionId
              && data.taskId == taskId
              && data.resourceId == resourceId
              && data.resourceKind in ["attachment", "link"]
              && data.resourceLabel is string
              && data.resourceLabel.size() > 0
              && data.studentId == studentId
              && data.studentName is string
              && data.studentName.size() > 0
              && data.firstOpenedAt is timestamp
              && data.lastOpenedAt is timestamp
              && data.viewCount is int
              && data.viewCount > 0;
          }

          allow read: if taskBelongsToInstitution(parentTask()) && (
            isTaskStaff(parentTask()) || request.auth.uid == studentId
          );
          allow create: if taskBelongsToInstitution(parentTask())
            && isAssignedStudent(parentTask())
            && parentTask().status in ["published", "closed"]
            && request.auth.uid == studentId
            && validResourceView(request.resource.data)
            && request.resource.data.viewCount == 1;
          allow update: if taskBelongsToInstitution(parentTask())
            && isAssignedStudent(parentTask())
            && parentTask().status in ["published", "closed"]
            && request.auth.uid == studentId
            && validResourceView(request.resource.data)
            && request.resource.data.institutionId == resource.data.institutionId
            && request.resource.data.taskId == resource.data.taskId
            && request.resource.data.resourceId == resource.data.resourceId
            && request.resource.data.resourceKind == resource.data.resourceKind
            && request.resource.data.resourceLabel == resource.data.resourceLabel
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.studentName == resource.data.studentName
            && request.resource.data.firstOpenedAt == resource.data.firstOpenedAt
            && request.resource.data.viewCount == resource.data.viewCount + 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["lastOpenedAt", "viewCount"]);
          allow delete: if false;
        }

        match /entregas/{studentId} {
          allow read: if taskBelongsToInstitution(parentTask()) && (
            isTaskStaff(parentTask()) || request.auth.uid == studentId
          );
          allow create: if canStudentSubmit(studentId)
            && request.resource.data.institutionId == institutionId
            && request.resource.data.taskId == taskId
            && request.resource.data.studentId == studentId
            && request.resource.data.teacherId == parentTask().createdBy
            && request.resource.data.status == "submitted"
            && request.resource.data.version == 1;
          allow update: if taskBelongsToInstitution(parentTask()) && (
            (
              canStudentSubmit(studentId)
              && resource.data.studentId == studentId
              && request.resource.data.studentId == studentId
              && request.resource.data.teacherId == resource.data.teacherId
              && request.resource.data.taskId == resource.data.taskId
              && request.resource.data.institutionId == resource.data.institutionId
              && request.resource.data.status == "submitted"
              && request.resource.data.version == resource.data.version + 1
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "content", "attachments", "status", "version", "submittedAt",
                "updatedAt", "teacherFeedback"
              ])
            ) || (
              isTaskStaff(parentTask())
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.teacherId == resource.data.teacherId
              && request.resource.data.taskId == resource.data.taskId
              && request.resource.data.institutionId == resource.data.institutionId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status", "teacherFeedback", "feedbackAt", "reviewedAt", "updatedAt"
              ])
              && request.resource.data.status in ["feedback", "reviewed"]
            )
          );
          allow delete: if false;

          match /historial/{eventId} {
            allow read: if taskBelongsToInstitution(parentTask()) && (
              isTaskStaff(parentTask()) || request.auth.uid == studentId
            );
            allow create: if taskBelongsToInstitution(parentTask()) && (
              (
                canStudentSubmit(studentId)
                && request.resource.data.authorId == studentId
                && request.resource.data.authorRole == "student"
                && request.resource.data.type in ["submitted", "resubmitted"]
              ) || (
                isTaskStaff(parentTask())
                && request.resource.data.authorId == request.auth.uid
                && request.resource.data.authorRole in ["teacher", "director"]
                && request.resource.data.type in ["feedback", "reviewed"]
              )
            );
            allow update, delete: if false;
          }
        }
      }

      match /materials/{materialId} {
        function canReadMaterial(data) {
          return isActive()
            && profile().institutionId == institutionId
            && (
              isDirector()
              || (
                roleIs("teacher")
                && data.managerIds is list
                && request.auth.uid in data.managerIds
              )
              || (
                roleIs("student")
                && data.audienceStudentIds is list
                && request.auth.uid in data.audienceStudentIds
              )
            );
        }

        function parentMaterial() {
          return get(
            /databases/$(database)/documents/institutions/$(institutionId)/materials/$(materialId)
          ).data;
        }

        allow read: if canReadMaterial(resource.data);
        allow create, update, delete: if false;

        match /views/{studentId} {
          function canReadMaterialView() {
            let material = parentMaterial();
            return canReadMaterial(material) && (
              isDirector()
              || (
                roleIs("teacher")
                && request.auth.uid in material.managerIds
              )
              || request.auth.uid == studentId
            );
          }

          function studentCanOpenMaterial() {
            let material = parentMaterial();
            return roleIs("student")
              && request.auth.uid == studentId
              && material.institutionId == institutionId
              && profile().institutionId == institutionId
              && material.audienceStudentIds is list
              && studentId in material.audienceStudentIds;
          }

          allow read: if canReadMaterialView();
          allow create: if studentCanOpenMaterial()
            && request.resource.data.keys().hasOnly([
              "institutionId", "materialId", "studentId", "studentName",
              "firstOpenedAt", "lastOpenedAt", "viewCount"
            ])
            && request.resource.data.institutionId == institutionId
            && request.resource.data.materialId == materialId
            && request.resource.data.studentId == studentId
            && request.resource.data.studentName == profile().name
            && request.resource.data.firstOpenedAt == request.time
            && request.resource.data.lastOpenedAt == request.time
            && request.resource.data.viewCount == 1;
          allow update: if studentCanOpenMaterial()
            && request.resource.data.institutionId == resource.data.institutionId
            && request.resource.data.materialId == resource.data.materialId
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.studentName == resource.data.studentName
            && request.resource.data.firstOpenedAt == resource.data.firstOpenedAt
            && request.resource.data.lastOpenedAt == request.time
            && request.resource.data.viewCount == resource.data.viewCount + 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["lastOpenedAt", "viewCount"]);
          allow delete: if false;
        }
      }

      match /{collectionName}/{documentId} {
        allow read: if collectionName != "materials"
          && isActive()
          && profile().institutionId == institutionId;
        allow create, update: if collectionName != "materials"
          && isDirector()
          && profile().institutionId == institutionId
          && request.resource.data.institutionId == institutionId;
        allow delete: if false;
      }
    }

    match /weeklyPlans/{planId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() || resource.data.status == "published"
      );
      allow create: if isStaff()
        && sameInstitution(request.resource.data)
        && validCalendarScope(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data)
        && sameCalendarScope(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /weeklyReviews/{reviewId} {
      function canReadReview(data) {
        return sameInstitution(data) && (
          isDirector()
          || (
            roleIs("teacher")
            && data.managerIds is list
            && request.auth.uid in data.managerIds
          )
          || (
            roleIs("student")
            && data.audienceStudentIds is list
            && request.auth.uid in data.audienceStudentIds
            && data.status in ["published", "closed"]
          )
        );
      }

      function parentReview() {
        return get(
          /databases/$(database)/documents/weeklyReviews/$(reviewId)
        ).data;
      }

      allow read: if canReadReview(resource.data);
      // Creación, publicación, guardado de avance y calificación pasan por
      // Cloud Functions para que la clave nunca sea confiada al cliente.
      allow create, update, delete: if false;

      match /attempts/{studentId} {
        allow read: if canReadReview(parentReview()) && (
          isDirector()
          || (
            roleIs("teacher")
            && request.auth.uid in parentReview().managerIds
          )
          || (
            roleIs("student")
            && request.auth.uid == studentId
          )
        );
        allow create, update, delete: if false;
      }

      match /answerKeys/{keyId} {
        allow read, write: if false;
      }
    }

    match /tasks/{taskId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() || resource.data.status in ["published", "closed", "archived"]
      );
      allow create: if isStaff() && sameInstitution(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data);
      allow delete: if false;

      match /submissions/{submissionId} {
        function parentTaskIsVisible() {
          return sameInstitution(
            get(/databases/$(database)/documents/tasks/$(taskId)).data
          );
        }

        allow read: if parentTaskIsVisible() && (
          isStaff() || resource.data.studentId == request.auth.uid
        );
        allow create: if roleIs("student")
          && parentTaskIsVisible()
          && request.resource.data.studentId == request.auth.uid;
        allow update: if parentTaskIsVisible() && (isStaff() || (
          roleIs("student")
          && resource.data.studentId == request.auth.uid
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "answers", "attachments", "content", "status", "submittedAt", "updatedAt"
          ])
        ));
        allow delete: if false;
      }
    }

    match /weeklyMaterials/{materialId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() || resource.data.status in ["published", "archived"]
      );
      allow create: if isStaff()
        && sameInstitution(request.resource.data)
        && validCalendarScope(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data)
        && sameCalendarScope(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /weeklyProgress/{progressId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() ||
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status in ["published", "corrected"]
        )
      );
      allow create: if isStaff()
        && sameInstitution(request.resource.data)
        && validCalendarScope(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data)
        && sameCalendarScope(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /weeklyReports/{reportId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() ||
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status == "published"
        )
      );
      allow create: if isStaff()
        && sameInstitution(request.resource.data)
        && validCalendarScope(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data)
        && sameCalendarScope(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /muralEditions/{editionId} {
      allow read: if sameInstitution(resource.data);
      // La asignación editorial y la portada se validan en Cloud Functions.
      allow create, update, delete: if false;
    }

    match /wallPosts/{postId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() ||
        resource.data.status == "published" ||
        (roleIs("student") && resource.data.authorId == request.auth.uid)
      );
      // Las transiciones editoriales, la identidad del aprobador y la auditoría
      // se escriben únicamente mediante Cloud Functions.
      allow create, update, delete: if false;
    }

    match /wallPostLikes/{likeId} {
      // Cada persona sólo consulta sus propios me gusta. El contador global
      // y la escritura del voto se actualizan de forma atómica en Cloud Functions.
      allow read: if sameInstitution(resource.data)
        && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    match /forums/{forumId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if isStaff() && sameInstitution(request.resource.data);
      allow update: if isStaff()
        && sameInstitution(resource.data)
        && sameInstitution(request.resource.data);
      allow delete: if false;

      match /topics/{topicId} {
        function parentForumIsVisible() {
          return sameInstitution(
            get(/databases/$(database)/documents/forums/$(forumId)).data
          );
        }

        allow read: if parentForumIsVisible();
        allow create, update: if isStaff() && parentForumIsVisible();
        allow delete: if false;

        match /posts/{postId} {
          allow read: if parentForumIsVisible()
            && resource.data.status != "hidden";
          allow create: if parentForumIsVisible()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.status == "published";
          allow update: if isStaff() && parentForumIsVisible();
          allow delete: if false;
        }
      }
    }

    // El foro usa documentos independientes para evitar que una respuesta
    // reescriba el estado completo del portal. Todas las mutaciones pasan por
    // Cloud Functions, donde también se generan notificaciones y auditoría.
    match /forumTopics/{topicId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() || request.auth.uid in resource.data.participantIds
      );
      allow create, update, delete: if false;
    }

    match /forumPosts/{postId} {
      allow read: if sameInstitution(resource.data) && (
        isStaff() || request.auth.uid in resource.data.participantIds
      );
      allow create, update, delete: if false;
    }

    match /forumModeration/{caseId} {
      allow read: if isStaff() && sameInstitution(resource.data);
      allow create, update, delete: if false;
    }

    match /forumBans/{institutionId}/users/{userId} {
      allow read: if isActive()
        && profile().institutionId == institutionId
        && (isDirector() || request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isActive() && request.auth.uid == userId;
      allow update: if isActive()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read", "archivedAt"]);
      allow create, delete: if false;
    }

    match /guardianContacts/{contactId} {
      allow read: if isDirector() && sameInstitution(resource.data);
      allow create, update, delete: if false;
    }

    match /messageOutbox/{messageId} {
      allow read: if isDirector() && sameInstitution(resource.data);
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isDirector() && sameInstitution(resource.data);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
